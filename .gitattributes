* text=auto

# 后端
*.py    text eol=lf
*.sql   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf

# 前端
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf

# 脚本与文档
*.md    text eol=lf
*.sh    text eol=lf

# Windows 批处理必须保持 CRLF，否则部分环境会解析异常
*.bat   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.zip   binary
